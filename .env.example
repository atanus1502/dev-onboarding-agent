ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_EVAL_CHANNEL=             # optional: channel id for the weekly eval report
# GitHub: either a GitHub App (recommended; tokens auto-refresh) ...
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=    # path to the App's .pem, keep it outside this folder
GITHUB_APP_INSTALLATION_ID=
# ... or a static token (fine-grained PAT with Metadata + Contents: read) for trying it out
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
CONFLUENCE_BASE_URL=https://acme.atlassian.net
CONFLUENCE_EMAIL=onboarding-bot@acme.com
CONFLUENCE_API_TOKEN=
ONBOARDING_MODEL=claude-opus-5-5
ONBOARDING_EFFORT=medium
ONBOARDING_SOURCES=config/sources.yaml
ONBOARDING_IDENTITIES=config/identities.yaml
ONBOARDING_DB=onboarding.db
